DATABASE_URL=postgres://scope:scope@localhost:5432/scope
SCOPE_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SCOPE_SESSION_SECRET=replace-with-a-long-random-string
SCOPE_SETUP_TOKEN=replace-with-a-one-time-random-token
NEXT_PUBLIC_APP_URL=http://localhost:3000
SCOPE_UPLOAD_DIR=/data/uploads
# Multipart uploads are memory-buffered in the current release. Default: 250 MiB.
SCOPE_MAX_UPLOAD_BYTES=262144000
# Optional S3-compatible storage
SCOPE_S3_ENDPOINT=
SCOPE_S3_REGION=us-east-1
SCOPE_S3_BUCKET=
SCOPE_S3_ACCESS_KEY=
SCOPE_S3_SECRET_KEY=
SCOPE_S3_FORCE_PATH_STYLE=false
# Optional mail and Web Push
SCOPE_SMTP_HOST=
SCOPE_SMTP_PORT=587
SCOPE_SMTP_SECURE=false
SCOPE_SMTP_USER=
SCOPE_SMTP_PASSWORD=
SCOPE_SMTP_FROM=
SCOPE_VAPID_PUBLIC_KEY=
SCOPE_VAPID_PRIVATE_KEY=
SCOPE_VAPID_SUBJECT=mailto:admin@localhost
# Optional OpenAI-compatible Whisper endpoint
SCOPE_TRANSCRIBER_URL=
SCOPE_TRANSCRIBER_API_KEY=
SCOPE_TRANSCRIBER_MODEL=base
# Use whisper-asr for ahmetoner/whisper-asr-webservice; otherwise OpenAI format is used.
SCOPE_TRANSCRIBER_FORMAT=openai

# The installer enables the bundled local Whisper service with these values.
COMPOSE_FILE=docker-compose.yml:docker-compose.transcription.yml
COMPOSE_PROFILES=transcription
